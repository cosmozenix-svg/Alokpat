rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "cosmozenix@gmail.com" ||
        request.auth.token.admin == true
      );
    }

    // Health check collection for connectivity test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if true; // Allows initial signup and registration
      allow update: if true; // Allows profile updates, following, verification
      allow delete: if true; // Allows admin account deletion
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if true; // Allows publishing posts
      allow update: if true; // Allows likes, reactions, saves, editing
      allow delete: if true; // Author or admin deletion
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Moderation Reports
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
